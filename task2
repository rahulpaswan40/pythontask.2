# --- 15 Examples of the pop() method ---
# Syntax: list.pop(index) -> index is optional (defaults to -1)

# 1. Popping the last element (default behavior)
list1 = [1, 2, 3, 4]
removed1 = list1.pop()
print("1. Removed last:", removed1, "| List:", list1)

# 2. Popping the first element (index 0)
list2 = ['a', 'b', 'c']
removed2 = list2.pop(0)
print("2. Removed index 0:", removed2, "| List:", list2)

# 3. Popping from the middle
list3 = [10, 20, 30, 40]
removed3 = list3.pop(1)
print("3. Removed index 1:", removed3, "| List:", list3)

# 4. Popping a Boolean value
list4 = [True, False, True]
list4.pop()
print("4. After pop:", list4)

# 5. Popping a float from a list
list5 = [1.1, 2.2, 3.3]
val5 = list5.pop(1)
print("5. Removed float:", val5)

# 6. Popping from a list of letters
list6 = ['x', 'y', 'z']
list6.pop(0)
print("6. After first pop:", list6)

# 7. Popping the only element (makes list empty)
list7 = [0]
list7.pop()
print("7. Empty now:", list7)

# 8. Popping using a negative index (-1 is the last item)
list8 = [100, 200, 300]
list8.pop(-1)
print("8. Negative index pop:", list8)

# 9. Popping a fruit from the list
list9 = ['apple', 'banana', 'cherry']
fruit = list9.pop(1)
print("9. Popped fruit:", fruit)

# 10. Popping from multiples of five
list10 = [5, 10, 15, 20]
list10.pop(2)
print("10. Remaining:", list10)

# 11. Popping an animal string
list11 = ['cat', 'dog', 'fish']
list11.pop()
print("11. After pop:", list11)

# 12. Popping an odd number
list12 = [1, 3, 5, 7]
list12.pop(0)
print("12. Remaining odds:", list12)

# 13. Popping a color
list13 = ['red', 'blue', 'green']
list13.pop(1)
print("13. Remaining colors:", list13)

# 14. Popping a decimal
list14 = [2.5, 3.5, 4.5]
list14.pop()
print("14. After popping decimal:", list14)

# 15. Popping a location
list15 = ['home', 'village', 'city']
list15.pop(0)
print("15. Final list:", list15)

# --- 15 Examples of the insert() method ---
# Syntax: list.insert(index, element)

