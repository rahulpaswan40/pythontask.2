# --- 15 Examples of the remove() method ---
# Syntax: list.remove(value)

# 1. Removing an integer
list1 = [1, 2, 3, 4]
list1.remove(3)
print("1. Removed 3:", list1)

# 2. Removing a character
list2 = ['a', 'b', 'c']
list2.remove('b')
print("2. Removed 'b':", list2)

# 3. Removing the first occurrence of a duplicate
list3 = [10, 20, 10, 30]
list3.remove(10) # Only the first 10 is removed
print("3. Removed first 10:", list3)

# 4. Removing a Boolean value
list4 = [True, False, True]
list4.remove(False)
print("4. Removed False:", list4)

# 5. Removing a float
list5 = [1.1, 2.2, 3.3]
list5.remove(2.2)
print("5. Removed 2.2:", list5)

# 6. Removing a letter from a mixed list
list6 = ['x', 'y', 'z']
list6.remove('x')
print("6. Removed 'x':", list6)

# 7. Removing 0 from a sequence
list7 = [0, 1, 2]
list7.remove(0)
print("7. Removed 0:", list7)

# 8. Removing a large number
list8 = [100, 200, 300]
list8.remove(200)
print("8. Removed 200:", list8)

# 9. Removing a fruit name
list9 = ['apple', 'banana', 'cherry']
list9.remove('banana')
print("9. Removed banana:", list9)

# 10. Removing a multiple of 5
list10 = [5, 10, 15, 20]
list10.remove(15)
print("10. Removed 15:", list10)

# 11. Removing an animal string
list11 = ['cat', 'dog', 'fish']
list11.remove('dog')
print("11. Removed dog:", list11)

# 12. Removing an odd number
list12 = [1, 3, 5, 7]
list12.remove(5)
print("12. Removed 5:", list12)

# 13. Removing a color
list13 = ['red', 'blue', 'green']
list13.remove('red')
print("13. Removed red:", list13)

# 14. Removing a decimal
list14 = [2.5, 3.5, 4.5]
list14.remove(3.5)
print("14. Removed 3.5:", list14)

# 15. Removing a location
list15 = ['home', 'village', 'city']
list15.remove('village')
print("15. Removed village:", list15)

